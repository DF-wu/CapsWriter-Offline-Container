# Public image
CAPSWRITER_SERVER_IMAGE=ghcr.io/df-wu/capswriter-offline-server:latest

# Model selection
# qwen_asr      = 主預設; 對話精度高, HTTP API / 長段轉錄場景的首選
# fun_asr_nano  = 低延遲首選; HTTP API 即時互動 / airi / whisper SDK 場景推薦
#                 直接在此處設定 fun_asr_nano；不需要另一份 Compose。
CAPSWRITER_MODEL_TYPE=qwen_asr

# Qwen preset
# default      = primary preset; best overall default on current real-audio benchmark
# low_vram_gpu = ONNX on GPU, llama on CPU; useful when GPU helps but VRAM is limited
# cpu_only     = ONNX CPU, llama CPU
CAPSWRITER_QWEN_PRESET=default
# Default false preserves the original CPU/Vulkan backend selection.
# true opts into the Tesla P4-only SM61 runtime. Requires NVIDIA GPU access.
# No clock, power, permission or model-weight changes. Restart required.
CAPSWRITER_TESLA_P4_OPTIMIZATION=false
# auto: original CPU/Vulkan selection; P4 CUDA only with the flag above.
# cpu/vulkan override the P4 choice; cuda also requires explicit P4 opt-in.
CAPSWRITER_LLAMA_BACKEND=auto

# Inference hardware policy
# auto = prefer GPU, fall back to CPU
# gpu  = try GPU first, still fall back to CPU on runtime bootstrap/probe failure
# cpu  = force CPU only
# A GPU bootstrap or engine-probe failure disables every CUDA/Vulkan path,
# prepares the CPU runtime again, and requires a second CPU probe to pass.
# The opt-in P4 CUDA runtime instead stops on failure to avoid silent CPU use.
CAPSWRITER_INFERENCE_HARDWARE=auto

# NVIDIA device count used by the commented NVIDIA block in docker-compose.yml.
# all = expose all visible GPUs; a positive integer limits the reservation.
# CPU-only startup leaves that block commented instead of setting this to 0.
CAPSWRITER_GPU_DEVICE_COUNT=all

# Linux Intel/AMD groups used by the commented DRI block in docker-compose.yml.
# Replace these distro defaults with the numeric GIDs reported on the host:
#   stat -c '%n %g' /dev/dri/renderD* /dev/dri/card*
CAPSWRITER_DRI_RENDER_GID=109
CAPSWRITER_DRI_VIDEO_GID=44

# Networking and logs
# Docker Compose host interface for published WebSocket traffic.
# Keep loopback for local use; use 0.0.0.0 only when sharing deliberately.
CAPSWRITER_SERVER_PUBLISH_HOST=127.0.0.1
CAPSWRITER_SERVER_PORT=6016
# Maximum admitted WebSocket clients (validated range: 1..1024)
CAPSWRITER_SERVER_MAX_WEBSOCKET_CONNECTIONS=8
# Maximum cumulative audio seconds in one WebSocket task (range: 1..86400)
CAPSWRITER_SERVER_MAX_WEBSOCKET_TASK_SECONDS=3600
CAPSWRITER_LOG_LEVEL=INFO

# ==================== Desktop WebSocket client (source or packaged EXE) ====================
# Per-message send deadline. A timeout closes and cancels the current stream.
CAPSWRITER_CLIENT_WEBSOCKET_SEND_TIMEOUT=30
# Maximum wait for a final file result after the upload finishes. A timeout
# closes the connection so a late result cannot leak into the next file task.
CAPSWRITER_CLIENT_FILE_RESULT_TIMEOUT=600

# ==================== OpenAI-Compatible HTTP API (opt-in) ====================
# Expose POST /v1/audio/transcriptions in addition to WebSocket. The OpenAI
# Python/Node SDKs can use this endpoint by setting base_url. See docs/HTTP_API.md.
CAPSWRITER_HTTP_API_ENABLE=false
# Docker port publishing reaches services bound to the container interface.
# When enabling HTTP API in Docker, keep this as 0.0.0.0 and set a key.
CAPSWRITER_HTTP_API_BIND=0.0.0.0
# Docker Compose host interface for the optional HTTP API port mapping.
CAPSWRITER_HTTP_API_PUBLISH_HOST=127.0.0.1
CAPSWRITER_HTTP_API_PORT=6017
# Bearer token. Empty disables auth only for loopback/private binds; with
# 0.0.0.0, enabling HTTP API requires a key unless insecure bind is explicit.
CAPSWRITER_HTTP_API_KEY=
# Secret-file alternative for service managers or Docker secrets. Explicit
# CAPSWRITER_HTTP_API_KEY takes precedence when both are set.
CAPSWRITER_HTTP_API_KEY_FILE=
CAPSWRITER_HTTP_API_ALLOW_INSECURE_BIND=false
# Validated at startup: upload MB, decoded duration, and timeout must be >= 1.
CAPSWRITER_HTTP_API_MAX_UPLOAD_MB=100
CAPSWRITER_HTTP_API_MAX_AUDIO_SECONDS=3600
CAPSWRITER_HTTP_API_TASK_TIMEOUT=600
# Maximum concurrent HTTP transcription requests allowed to upload/decode/wait.
CAPSWRITER_HTTP_API_MAX_CONCURRENT_REQUESTS=2
# Requests beyond active work may wait only in this bounded queue; 0 disables it.
CAPSWRITER_HTTP_API_MAX_PENDING_REQUESTS=4
# Comma-separated browser origins allowed to call the HTTP API.
# Keep empty unless you run the web console from a different origin.
# Local Vite dev example:
# CAPSWRITER_HTTP_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAPSWRITER_HTTP_API_CORS_ORIGINS=
# Production default: do not log prompts, context, or transcript text.
CAPSWRITER_HTTP_API_LOG_TRANSCRIPTS=false

# ==================== Daily settings GUI (optional) ====================
# All options are in docker-compose.yml; /app/settings has a persistent named volume.
# Enable HTTP above, set an API key, then set SETTINGS_ENABLE=true here.
# Explicitly BLANK daily values (KEY=) to let the GUI manage them.
# Removing a key restores the Compose default; nonempty values lock the UI field.
CAPSWRITER_SETTINGS_ENABLE=false
# Server postprocessing (daily settings; blank delegates to saved JSON/defaults).
CAPSWRITER_FORMAT_NUM=true
CAPSWRITER_FORMAT_SPELL=true
# See docs/settings.md for the complete field list and restart semantics.
# Native/source servers instead export these variables explicitly:
# CAPSWRITER_SETTINGS_ENABLE=true
# CAPSWRITER_SETTINGS_PATH=/absolute/writable/path/server-settings.json
# Client settings are separate per-user data:
# CAPSWRITER_CLIENT_SETTINGS=/absolute/path/client-settings.json

# ==================== Web Console (optional Docker service) ====================
# Start with docker compose --profile web up -d, or set COMPOSE_PROFILES=web.
# This starts static UI only; enable the server HTTP API separately above.
# The API base is evaluated in the browser, not in the web container.
COMPOSE_PROFILES=
CAPSWRITER_WEB_IMAGE=ghcr.io/df-wu/capswriter-offline-web:latest
# Docker Compose host interface for the static web console.
CAPSWRITER_WEB_PUBLISH_HOST=127.0.0.1
CAPSWRITER_WEB_PORT=8080
CAPSWRITER_WEB_API_BASE=http://localhost:6017
# API keys in static Web config are public to every browser that can load it.
# Prefer entering the token in the UI; set this true only for trusted private deployments.
CAPSWRITER_WEB_ALLOW_PUBLIC_API_KEY=false
CAPSWRITER_WEB_API_KEY=
CAPSWRITER_WEB_MODEL=whisper-1
CAPSWRITER_WEB_LANGUAGE=
CAPSWRITER_WEB_PROMPT=
CAPSWRITER_WEB_RESPONSE_FORMAT=verbose_json

# Shared CPU thread hint for CPU-bound stages
CAPSWRITER_NUM_THREADS=4
# Socket idle timeout for model/llama archive downloads during container startup
CAPSWRITER_MODEL_DOWNLOAD_TIMEOUT=60
# Maximum wait for another container sharing the model volume to finish its
# transactional bootstrap (seconds; > 0 and <= 86400). The downloader rechecks
# readiness after acquiring the POSIX advisory lock.
CAPSWRITER_MODEL_BOOTSTRAP_LOCK_TIMEOUT=1800
# Maximum wall-clock time for one configured backend construction probe.
# The supervised probe fails closed on timeout; valid range: > 0 and <= 1800.
CAPSWRITER_BACKEND_PROBE_TIMEOUT=300
# Timeout for direct engine ffmpeg file decoding paths
CAPSWRITER_ENGINE_FFMPEG_TIMEOUT=120
# Optional NVIDIA memory-clock preboost. Requires a supported GPU and permission
# to change clocks; keep disabled until an explicit supported frequency is set.
# See docs/nvidia-boost.md and the commented NVIDIA_BOOST block in docker-compose.yml.
CAPSWRITER_GPU_BOOST_ENABLED=false
CAPSWRITER_GPU_BOOST_DEVICE=0
# 0 = unset; enabling boost requires a positive hardware-supported MHz value.
CAPSWRITER_GPU_BOOST_MEMORY_CLOCK_MHZ=0
CAPSWRITER_GPU_BOOST_IDLE_SECONDS=1
# Timeout per boost/reset command (0.1..60 seconds)
CAPSWRITER_GPU_BOOST_TIMEOUT=5
# Maximum startup wait for the recognizer child to finish loading models
CAPSWRITER_SERVER_MODEL_LOAD_TIMEOUT=600
# Graceful worker wait; automatically extended for boost cleanup when enabled.
CAPSWRITER_SERVER_WORKER_STOP_TIMEOUT=2
# Hard ceiling for one synchronous recognizer call before fail-stop
CAPSWRITER_SERVER_WORKER_STALL_TIMEOUT=900

# === Integrated-GPU compatibility patches (opt-in) ===
# 與 upstream c82a834 對齊。集顯（Intel/AMD iGPU）若 GGUF 載入或解碼出錯，
# 取消下面任一行的註解再重啟 server。N 卡與獨顯通常不需要動。
# GGML_VK_DISABLE_COOPMAT=1   # AMD 集顯無法載入 GGUF 模型時嘗試
# GGML_VK_DISABLE_F16=1       # 集顯解碼有誤、強制熔斷時嘗試

# Remove downloaded archives after extraction if disk is tight
CAPSWRITER_REMOVE_MODEL_ARCHIVES=false

# ==================== Qwen tuning ====================
# See docs/qwen-tuning.md for prefill, audio-length and memory tradeoffs.
# Server decode_stream truncates audio beyond CHUNK_SIZE; it does not split it.
CAPSWRITER_QWEN_CHUNK_SIZE=80
CAPSWRITER_QWEN_N_CTX=2048
# Used by the internal file-transcription path, not Server decode_stream calls.
CAPSWRITER_QWEN_MEMORY_NUM=1
# Fixed-shape padding is DirectML-only; this does not pad P4 CUDA input to 30s.
CAPSWRITER_QWEN_PAD_TO=30
# Empty preserves adapter defaults: requested batch=4096, ubatch=512.
# b7798 causal runtime caps batch by context (2048 by default).
# Server submits the full prefill in one call; too-small batch can abort it.
CAPSWRITER_QWEN_LLAMA_N_BATCH=
# Physical micro-batch: smaller may save workspace but slow prefill; benchmark.
CAPSWRITER_QWEN_LLAMA_N_UBATCH=
CAPSWRITER_QWEN_LLAMA_FLASH_ATTN=
CAPSWRITER_QWEN_LLAMA_OFFLOAD_KQV=

# ==================== Fun-ASR tuning ====================
CAPSWRITER_FUNASR_ENABLE_CTC=true
CAPSWRITER_FUNASR_N_PREDICT=512
CAPSWRITER_FUNASR_PAD_TO=30
CAPSWRITER_FUNASR_MAX_HOTWORDS=20
CAPSWRITER_FUNASR_SIMILAR_THRESHOLD=0.6

# Model storage: default preserves the existing named volume and appuser ownership.
# For operator-managed files set ./models or an absolute host directory; create
# it and grant the image appuser write access before starting. Keep old data.
CAPSWRITER_MODELS_SOURCE=capswriter-server-models
